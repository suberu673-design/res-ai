{
  "name": "@forex-platform/web",
  "version": "0.1.0",
  "description": "Web application for the forex trading platform",
  "private": true,
  "scripts": {
    "prebuild": "npm --workspace @forex-platform/types run build",
    "dev": "next dev -p 3000",
    "build": "next build",
    "pretypecheck": "npm --workspace @forex-platform/types run build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@forex-platform/types": "file:../../packages/types",
    "next": "^14.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
