{
  "name": "ai-forex-platform",
  "version": "0.1.0",
  "description": "AI-powered forex trading platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "database"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:api": "npm run build --workspace @forex-platform/types && npm run build --workspace @forex-platform/market-data && npm run db:generate && npm --workspace @forex-platform/api run dev",
    "dev:web": "npm --workspace @forex-platform/web run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,jsx,tsx,json,md}\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:health": "docker compose exec postgres pg_isready -U ai_forex -d ai_forex",
    "db:generate": "npm --workspace @forex-platform/database run generate",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:migrate": "npm --workspace @forex-platform/database run migrate:dev",
    "db:seed": "npm --workspace @forex-platform/database run seed",
    "db:setup": "npm run db:up && sleep 3 && npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:pull": "npm --workspace @forex-platform/database exec prisma db pull",
    "db:push": "npm --workspace @forex-platform/database exec prisma db push",
    "db:studio": "npm --workspace @forex-platform/database run studio"
  },
  "devDependencies": {
    "@prisma/client": "^5.7.1",
    "@types/node": "^20.10.6",
    "prisma": "^5.7.1",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
