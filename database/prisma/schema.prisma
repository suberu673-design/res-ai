// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User - platform user account
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradingAccounts TradingAccount[]
  aiEvents        AIEvent[]

  @@map("users")
}

// TradingAccount - user's trading account (can have multiple)
model TradingAccount {
  id             String   @id @default(cuid())
  userId         String
  accountName    String
  accountType    String   @default("DEMO") // DEMO or LIVE
  currency       String   @default("USD")
  initialBalance Float
  currentBalance Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades    Trade[]
  positions Position[]
  orders    Order[]

  @@index([userId])
  @@map("trading_accounts")
}

// MarketPair - forex pairs like EUR/USD
model MarketPair {
  id              String   @id @default(cuid())
  symbol          String   @unique
  baseCurrency    String
  quoteCurrency   String
  description     String   @default("")
  source          String   @default("system")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trades    Trade[]
  positions Position[]
  orders    Order[]

  @@map("market_pairs")
}

model MarketCandle {
  id        String    @id @default(cuid())
  symbol    String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String    @default("mock")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@map("market_candles")
}

// Strategy - trading strategies
model Strategy {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String   @default("")
  tradingStyle  String   @default("SWING") // SCALPING, INTRADAY, SHORT_TERM, SWING, POSITION
  operatingMode String   @default("SCOUT") // SCOUT, ANALYST, AUTONOMOUS_PAPER, HUMAN_APPROVAL, LIVE_AUTONOMOUS
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions       StrategyVersion[]
  tradeProposals TradeProposal[]

  @@map("strategies")
}

model StrategyVersion {
  id         String   @id @default(cuid())
  strategyId String
  version    String
  name       String?
  parameters Json?
  status     String   @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strategy        Strategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  tradeProposals  TradeProposal[]

  @@index([strategyId])
  @@map("strategy_versions")
}

model AIAnalysisHistory {
  id                    String   @id @default(cuid())
  opportunityId         String?
  symbol                String
  tradingMode           String?
  timeframe             String?
  direction             String?
  assessment            String?
  confidence            Float?
  summary               String?
  reasons               Json?
  risks                 Json?
  invalidationConditions Json?
  provider              String?
  model                 String?
  marketDataMode        String?
  sourceContext         Json?
  analyzedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  proposals TradeProposal[]

  @@index([symbol])
  @@map("ai_analysis_history")
}

model TradeProposal {
  id                     String    @id @default(cuid())
  opportunityId          String?
  aiAnalysisId           String?
  strategyId             String?
  strategyVersionId      String?
  symbol                 String
  tradingMode            String?
  tradingStyle           String?
  direction              String
  proposedEntryPrice     Float?
  proposedStopPrice      Float?
  proposedTargetPrice    Float?
  riskRewardRatio        Float?
  confidence             Float?
  thesis                 String?
  invalidationConditions Json?
  status                 String    @default("DRAFT") // DRAFT, ANALYZED, RISK_PENDING, APPROVED, REJECTED, EXPIRED
  approvalStatus         String?
  approvedBy             String?
  approvedAt             DateTime?
  rejectedReason         String?
  expiresAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  strategy          Strategy?           @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  strategyVersion   StrategyVersion?    @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  aiAnalysisHistory AIAnalysisHistory?  @relation(fields: [aiAnalysisId], references: [id], onDelete: SetNull)
  riskDecisions     RiskDecision[]
  orders            Order[]
  trades            Trade[]
  journalEvents     JournalEvent[]
  executionEvents   ExecutionEvent[]
  positions         Position[]

  @@index([status])
  @@index([symbol])
  @@map("trade_proposals")
}

model RiskDecision {
  id             String    @id @default(cuid())
  tradeProposalId String
  status         String    @default("PENDING") // PENDING, PASS, FAIL, OVERRIDE_REQUIRED, BLOCKED
  evaluatedAt    DateTime?
  reason         String?
  riskFlags      Json?
  evaluator      String    @default("system")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tradeProposal TradeProposal @relation(fields: [tradeProposalId], references: [id], onDelete: Cascade)

  @@index([tradeProposalId])
  @@map("risk_decisions")
}

// Trade - record of a trade (completed or active)
model Trade {
  id                String   @id @default(cuid())
  accountId         String
  pairId            String
  proposalId        String?
  direction         String   @default("LONG") // LONG or SHORT
  entryPrice        Float
  entryTime         DateTime
  exitPrice         Float?
  exitTime          DateTime?
  quantity          Float
  status            String   @default("OPEN") // PROPOSED, OPEN, PARTIALLY_CLOSED, CLOSED, CANCELLED, REJECTED
  profitLoss        Float?
  profitLossPercent Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account      TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pair         MarketPair     @relation(fields: [pairId], references: [id])
  tradeProposal TradeProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  journalEvents JournalEvent[]
  executionEvents ExecutionEvent[]

  @@index([accountId])
  @@index([pairId])
  @@index([proposalId])
  @@map("trades")
}

// Position - an active open position
model Position {
  id         String   @id @default(cuid())
  accountId  String
  pairId     String
  proposalId String?
  direction  String   @default("LONG") // LONG or SHORT
  entryPrice Float
  entryTime  DateTime
  quantity   Float
  status     String   @default("OPEN") // OPEN, PARTIALLY_CLOSED, CLOSED, LIQUIDATED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pair    MarketPair     @relation(fields: [pairId], references: [id])
  proposal TradeProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([pairId])
  @@index([proposalId])
  @@map("positions")
}

// Order - pending or executed orders
model Order {
  id         String   @id @default(cuid())
  accountId  String
  pairId     String
  proposalId String?
  direction  String   @default("LONG") // LONG or SHORT
  orderType  String   @default("MARKET") // MARKET, LIMIT, STOP, STOP_LIMIT
  quantity   Float
  price      Float?
  stopPrice  Float?
  status     String   @default("PENDING") // PENDING, SUBMITTED, PARTIALLY_FILLED, FILLED, CANCELLED, REJECTED, FAILED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pair    MarketPair     @relation(fields: [pairId], references: [id])
  tradeProposal TradeProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  executionEvents ExecutionEvent[]

  @@index([accountId])
  @@index([pairId])
  @@index([proposalId])
  @@map("orders")
}

model JournalEvent {
  id             String   @id @default(cuid())
  tradeId        String?
  tradeProposalId String?
  eventType      String
  message        String?
  metadata       Json?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())

  trade         Trade?         @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  tradeProposal TradeProposal? @relation(fields: [tradeProposalId], references: [id], onDelete: SetNull)

  @@index([tradeId])
  @@index([tradeProposalId])
  @@map("journal_events")
}

model ExecutionEvent {
  id             String   @id @default(cuid())
  orderId        String?
  tradeId        String?
  tradeProposalId String?
  eventType      String
  metadata       Json?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())

  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  trade         Trade?         @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  tradeProposal TradeProposal? @relation(fields: [tradeProposalId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([tradeId])
  @@index([tradeProposalId])
  @@map("execution_events")
}

// AIEvent - log of AI decisions and reasoning
model AIEvent {
  id        String   @id @default(cuid())
  accountId String?
  eventType String
  action    String
  reasoning String
  confidence Float   @default(0.5)
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@map("ai_events")
}
